VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set a real support/privacy contact before public onboarding.
# Public support email is intentionally pending domain setup; see src/services/supportContact.ts.

# Public catalogue API URL; database credentials stay server-side.
VITE_PUBLIC_CATALOGUE_URL=

# Clerk consumer authentication (public browser key only)
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=

# Optional admin/migration scripts only. Never use a VITE_ prefix for secrets.
CLERK_SECRET_KEY=

# Remote MCP stays disabled until its private OAuth migration is applied.
CAREERRADAR_MCP_ENABLED=false
# Optional exact canonical origin; defaults to the current production Vercel URL.
CAREERRADAR_MCP_ORIGIN=
# Optional comma-separated browser-client origins (never use *).
CAREERRADAR_MCP_ALLOWED_ORIGINS=
